# Copy to .env for local use. Never commit real values. On Streamlit Community Cloud use App settings -> Secrets.
# Everything is optional: with no values the app runs in DEMO MODE on a local SQLite file.

# Local SQLite file (ephemeral on Streamlit Community Cloud - data can reset when the app restarts)
BCRA_DB_PATH=data/bc_research.db

# Optional Supabase/Postgres connection string (Project Settings -> Database -> Connection string, URI).
# Requires adding `psycopg[binary]>=3.1` to requirements.txt. Keep this secret; it is read server-side only.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@<host>:6543/postgres

# Starting VIRTUAL research budget (INR)
BCRA_DEFAULT_BUDGET=1000

# ASSUMED house edge used by the simulation models (a modelling assumption, NOT a verified BC.GAME figure)
BCRA_ASSUMED_HOUSE_EDGE=0.01

# Domains accepted as "official" when recording a source (comma separated)
BCRA_OFFICIAL_DOMAINS=bc.game

# Limits
BCRA_MAX_UPLOAD_BYTES=5000000
BCRA_MAX_UPLOAD_ROWS=200000
BCRA_MAX_SESSION_ROUNDS=1000
BCRA_SIMS_PER_MINUTE=30

# Optional (not required, not implemented by default): key for an optional LLM wording helper
# BCRA_OPTIONAL_LLM_API_KEY=
